# Copy to .env (loaded by systemd via EnvironmentFile)
HARNESS_PORT=3000
HARNESS_MAX_CONCURRENT=4
HARNESS_DOMAIN=167-233-160-246.sslip.io
# HARNESS_DEFAULT_MODEL=claude-sonnet-5   # unset = Claude Code default
HARNESS_MAX_TURNS=100
# Phase 2:
# DISCORD_BOT_TOKEN=...

# Reasoning effort for every agent turn: low|medium|high|xhigh|max
HARNESS_EFFORT=high

# Idle reaper: terminate non-standing agents parked this long with an empty inbox (0 = off)
HARNESS_IDLE_REAP_MS=3600000
HARNESS_REAP_SWEEP_MS=60000
